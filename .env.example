OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# URL de la API HTTP, no de PostgreSQL. No agregar /api-docs.
API_BASE_URL=http://127.0.0.1:3000
API_EMAIL=regular@example.com
API_PASSWORD=
API_TIMEOUT_MS=15000

CRON_EXPRESSION=*/1 * * * *
CRON_TIMEZONE=America/Argentina/Buenos_Aires
# Primera prueba: consulta y simula; no envía POST /invoices.
DRY_RUN=true
MAX_INVOICES_PER_RUN=10
MAX_DOCUMENT_PAGES=10
RUN_TIMEOUT_MS=180000
LOG_DIRECTORY=logs
