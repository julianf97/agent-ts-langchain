{
  "name": "agent-ts-langchain",
  "version": "1.0.0",
  "private": true,
  "description": "Agente de facturaci\u00f3n para api-agente con TypeScript, LangChain y OpenAI.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "agent:once": "tsx src/index.ts --once",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "tsx --test tests/*.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@langchain/core": "^1.2.13",
    "@langchain/openai": "^1.6.0",
    "dotenv": "^18.0.4",
    "langchain": "^1.5.14",
    "node-cron": "^4.6.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
